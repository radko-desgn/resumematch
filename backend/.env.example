# ResumeMatch backend — local environment template.
# Copy to backend/.env and fill in. backend/.env is gitignored (never commit secrets).
# In production these are set on the host (Render) instead of a file.

# --- Supabase (accounts, credits ledger, free-scan limits) -------------------
SUPABASE_URL=https://eyrnlguyvaxjmmxinkrc.supabase.co
SUPABASE_SECRET_KEY=            # service_role / secret key (Supabase → Project settings → API)

# --- Stripe (payments) -------------------------------------------------------
# Start with TEST keys. Real payments only after switching to live keys.
STRIPE_SECRET_KEY=              # sk_test_...  (Stripe → Developers → API keys)
STRIPE_WEBHOOK_SECRET=         # whsec_...   (from `stripe listen`, or the dashboard endpoint)
STRIPE_CURRENCY=eur

# Price IDs — produced by `python -m backend.stripe_setup`, then pasted here:
STRIPE_PRICE_SINGLE=           # price_...
STRIPE_PRICE_HUNTER=           # price_...
STRIPE_PRICE_PRO=              # price_...

# Where Stripe sends the browser back after checkout.
FRONTEND_URL=http://localhost:3001

# --- Optional (only needed for live analysis / email) ------------------------
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# FRONTEND_ORIGINS=https://resumematch.pro,https://www.resumematch.pro
